# Assistant configuration
# Change this to rename the assistant everywhere triggers are matched.
ASSISTANT_NAME=Andy

# Set to 'true' if the assistant has its own phone number (affects WhatsApp behavior).
ASSISTANT_HAS_OWN_NUMBER=false

# Enabled channels (comma-separated): whatsapp, voice, telegram, etc.
CHANNELS=whatsapp

# Soul capability — accumulates structured memory and scaffolds a per-group wiki.
# Phase 1: data capture only (no LLM calls).
SOUL_ENABLED=false

# Soul identity (Phase 3) — cryptographic agent identity served over HTTPS.
# If SOUL_DOMAIN is not set, the identity server does NOT start; memory + wiki
# curation still work normally. With a domain set, the soul boots an Ed25519
# keypair under ~/.config/nanoclaw/soul/ and serves /.well-known/did.json and
# /.well-known/agent-description.json on 127.0.0.1:SOUL_PORT (default 8444).
# Tailscale Funnel terminates TLS in front of it.
# SOUL_DOMAIN=nanoclaw.tailnet.ts.net
# SOUL_PORT=8444
# SOUL_OWNER=Will
# SOUL_NAME=Andy
# SOUL_TRAITS=helpful,curious,proactive
# SOUL_DESCRIPTION=Personal AI assistant
